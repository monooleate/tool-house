---
import CategoryLayout from "../../layouts/CategoryLayout.astro";
import { getCategoryInfo, getToolsByCategory } from "../../lib/tool-registry.ts";

const category = getCategoryInfo("markdown")!;
const tools = getToolsByCategory("markdown");
---

<CategoryLayout
  category={category}
  tools={tools}
  title={`${category.label} eszközök online | Konvertalo.hu`}
  description={category.description}
/>
