---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVisibleActiveTools, CATEGORIES, getLocalizedCategory, getLocalizedTool, getVisibleCategories } from "../lib/tool-registry.ts";
import { t, tpl, CURRENT_LANG, CURRENT_CONFIG } from "../i18n/index.ts";
import { toolUrl, categoryUrl } from "../lib/url-utils.ts";

const suggestions = getVisibleActiveTools(CURRENT_LANG).slice(0, 4).map(tool => getLocalizedTool(tool, CURRENT_LANG));
const visibleCats = getVisibleCategories(CURRENT_LANG).slice(0, 2);
---

<BaseLayout
  title={tpl("404.meta_title", { siteName: CURRENT_CONFIG.siteName })}
  description={t("404.meta_desc")}
  noIndex={true}
>
  <div class="not-found container">
    <div class="not-found__code" aria-hidden="true">404</div>
    <h1 class="not-found__title">{t("404.title")}</h1>
    <p class="not-found__desc">
      {t("404.subtitle")}
    </p>

    {suggestions.length > 0 && (
      <div class="suggestions">
        <p class="suggestions__label">{t("404.active_tools")}</p>
        <ul class="suggestions__list" role="list">
          {suggestions.map((tool) => {
            const cat = CATEGORIES.find(c => c.id === tool.category);
            return (
              <li>
                <a href={toolUrl(tool)} class="suggestion-card">
                  <span class="suggestion-card__icon" aria-hidden="true">{cat?.icon}</span>
                  <span class="suggestion-card__title">{tool.h1}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )}

    <div class="not-found__actions">
      <a href="/" class="btn btn--primary btn--lg">← {t("404.back_home")}</a>
      {visibleCats.map(cat => (
        <a href={categoryUrl(cat.id)} class="btn btn--outline">{cat.label}</a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
.not-found {
  padding: var(--sp-16) 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--sp-6);
  max-width: 640px;
}

.not-found__code {
  font-family: var(--font-mono);
  font-size: clamp(5rem, 15vw, 9rem);
  font-weight: 700;
  color: var(--border);
  line-height: 1;
  letter-spacing: -0.05em;
  user-select: none;
}

.not-found__title {
  font-size: clamp(1.5rem, 4vw, 2.25rem);
  margin-top: calc(-1 * var(--sp-4));
}

.not-found__desc {
  font-size: 1.0625rem;
  max-width: 44ch;
  text-align: center;
}

/* Suggestions */
.suggestions { width: 100%; }

.suggestions__label {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-subtle);
  margin-bottom: var(--sp-3);
}

.suggestions__list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: var(--sp-3);
  list-style: none;
  padding: 0; margin: 0;
}

.suggestion-card {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  text-decoration: none;
  transition: all var(--t-fast);
}

.suggestion-card:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
}

.suggestion-card__icon { font-size: 1.25rem; }

.suggestion-card__title {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--text);
  text-align: left;
}

/* Actions */
.not-found__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-3);
  justify-content: center;
  margin-top: var(--sp-2);
}
</style>
