---
import ToolLayout from "../../layouts/ToolLayout.astro";
import DelimiterConvertTool from "../../components/tools/adat/DelimiterConvertTool.svelte";
import { getToolBySlug } from "../../lib/tool-registry.ts";

const tool = getToolBySlug("adat", "tsv-csv")!;
---

<ToolLayout tool={tool}>
  <DelimiterConvertTool
    client:visible
    inputLabel="TSV fajl"
    outputLabel="CSV kimenet"
    inputAccept=".tsv,.txt"
    workerType="tsv-to-csv"
    outputExtension="csv"
  />
</ToolLayout>
