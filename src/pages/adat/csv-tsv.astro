---
import ToolLayout from "../../layouts/ToolLayout.astro";
import DelimiterConvertTool from "../../components/tools/adat/DelimiterConvertTool.svelte";
import { getToolBySlug } from "../../lib/tool-registry.ts";

const tool = getToolBySlug("adat", "csv-tsv")!;
---

<ToolLayout tool={tool}>
  <DelimiterConvertTool
    client:visible
    inputLabel="CSV fajl"
    outputLabel="TSV kimenet"
    inputAccept=".csv,.txt"
    workerType="csv-to-tsv"
    outputExtension="tsv"
  />
</ToolLayout>
