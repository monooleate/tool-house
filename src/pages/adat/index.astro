---
import CategoryLayout from "../../layouts/CategoryLayout.astro";
import { getCategoryInfo, getToolsByCategory } from "../../lib/tool-registry.ts";

const category = getCategoryInfo("adat")!;
const tools = getToolsByCategory("adat");
---

<CategoryLayout
  category={category}
  tools={tools}
  title="Adat eszközök online | CSV, JSON, TSV konvertálás"
  description="CSV↔JSON, TSV konvertálás, adattisztítás – minden böngészőben, szerver nélkül. Ingyenes, privát."
/>
