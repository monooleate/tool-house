---
// ============================================================
// [category]/[slug].astro – Dinamikus tool route (NEM conversii)
// Egyetlen fájl generálja az összes tool oldalt – KIVÉVE a
// conversii kategóriát, ami /conversii/{subcat}/{slug}/ alatt él.
// ============================================================
import ToolLayout from "../../layouts/ToolLayout.astro";
import DynamicTool from "../../components/tools/DynamicTool.svelte";
import { getVisibleTools } from "../../lib/tool-registry.ts";
import { toolUrl } from "../../lib/url-utils.ts";

export function getStaticPaths() {
  // A `conversii` kategória tool-jai a [subcat]/[slug].astro-ban generálódnak
  // (3-szegmensű URL hierarchia). Itt csak a többi tool jön létre.
  const tools = getVisibleTools().filter(t => t.category !== "conversii");
  return tools.map((tool) => {
    const url = toolUrl(tool);
    const parts = url.split("/").filter(Boolean);
    return {
      params: { category: parts[0], slug: parts[1] },
      props: {
        tool,
        componentName: tool.component ?? "",
        componentProps: tool.componentProps ?? {},
      },
    };
  });
}

const { tool, componentName, componentProps: cProps } = Astro.props;
---

<ToolLayout tool={tool}>
  {tool.status === "active" && componentName && (
    <DynamicTool client:visible componentName={componentName} componentProps={cProps} />
  )}
</ToolLayout>
