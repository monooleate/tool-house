---
// ============================================================
// [category]/index.astro – Dinamikus kategória route
// Egyetlen fájl generálja az összes kategória oldalt (10+).
// A `conversii` kategória extra szekciót kap: sub-hub kártyák.
// ============================================================
import CategoryLayout from "../../layouts/CategoryLayout.astro";
import {
  CATEGORIES,
  getToolsByCategory,
  getCategoryInfo,
  getLocalizedCategory,
  getVisibleCategories,
} from "../../lib/tool-registry.ts";
import { categoryUrl } from "../../lib/url-utils.ts";
import { CONVERSII_HUBS } from "../../lib/content/ro/conversii-hubs.ts";
import { t, CURRENT_LANG } from "../../i18n/index.ts";

export function getStaticPaths() {
  return getVisibleCategories().map((cat) => {
    const url = categoryUrl(cat.id);
    const catSlug = url.replace(/^\//, "").replace(/\/$/, "");
    return {
      params: { category: catSlug },
      props: { categoryId: cat.id },
    };
  });
}

const { categoryId } = Astro.props;
const category = getCategoryInfo(categoryId)!;
const tools = getToolsByCategory(categoryId);

// Conversii fő hub: sub-hub-ok átadása a layout-nak
const conversionHubs = (categoryId === "conversii" && CURRENT_LANG === "ro")
  ? CONVERSII_HUBS
  : undefined;
---

<CategoryLayout
  category={category}
  tools={tools}
  title={t(`cat_meta.${categoryId}_title`)}
  description={t(`cat_meta.${categoryId}_desc`)}
  conversionHubs={conversionHubs}
/>
