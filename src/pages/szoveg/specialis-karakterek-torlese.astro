---
import ToolLayout from "../../layouts/ToolLayout.astro";
import TextTransformTool from "../../components/tools/shared/TextTransformTool.svelte";
import { getToolBySlug } from "../../lib/tool-registry.ts";

const tool = getToolBySlug("szoveg", "specialis-karakterek-torlese")!;
---

<ToolLayout tool={tool}>
  <TextTransformTool
    client:visible
    operation="remove-special-chars"
    operationLabel="Speciális karakterek törlése"
    placeholder="Illeszd be a szöveget – a speciális karakterek eltávolításra kerülnek..."
  />
</ToolLayout>
