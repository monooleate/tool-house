---
import ToolLayout from "../../layouts/ToolLayout.astro";
import TextTransformTool from "../../components/tools/shared/TextTransformTool.svelte";
import { getToolBySlug } from "../../lib/tool-registry.ts";

const tool = getToolBySlug("szoveg", "kisbetu-nagybetu")!;
---

<ToolLayout tool={tool}>
  <TextTransformTool
    client:visible
    operation="lowercase"
    operationLabel="Betűméret konvertálás"
    placeholder="Illeszd be a szöveget – válaszd ki a kívánt betűméretet..."
    modes={[
      { value: "lowercase", label: "kisbetű" },
      { value: "uppercase", label: "NAGYBETŰ" },
      { value: "titlecase", label: "Első Betű Nagy" },
    ]}
  />
</ToolLayout>
