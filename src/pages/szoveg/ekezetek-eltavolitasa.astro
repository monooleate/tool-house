---
import ToolLayout from "../../layouts/ToolLayout.astro";
import TextTransformTool from "../../components/tools/shared/TextTransformTool.svelte";
import { getToolBySlug } from "../../lib/tool-registry.ts";

const tool = getToolBySlug("szoveg", "ekezetek-eltavolitasa")!;
---

<ToolLayout tool={tool}>
  <TextTransformTool
    client:visible
    operation="remove-accents"
    operationLabel="Ékezetek eltávolítása"
    placeholder="Illeszd be az ékezetes szöveget – á→a, ö→o, ű→u stb."
  />
</ToolLayout>
