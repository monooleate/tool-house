---
import ToolLayout from "../../layouts/ToolLayout.astro";
import TextTransformTool from "../../components/tools/shared/TextTransformTool.svelte";
import { getToolBySlug } from "../../lib/tool-registry.ts";

const tool = getToolBySlug("szoveg", "ures-sorok-torlese")!;
---

<ToolLayout tool={tool}>
  <TextTransformTool
    client:visible
    operation="remove-empty-lines"
    operationLabel="Üres sorok törlése"
    placeholder="Illeszd be a szöveget – az üres sorok automatikusan törlődnek..."
  />
</ToolLayout>
