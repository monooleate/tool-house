---
// ============================================================
// adatvedelmi-nyilatkozat.astro – Adatvédelmi nyilatkozat + Cookie
// ============================================================
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, SITE_URL, breadcrumbSchema } from "../lib/seo.ts";

const schemas = [
  breadcrumbSchema([
    { name: "Főoldal", href: "/" },
    { name: "Adatvédelmi nyilatkozat", href: "/adatvedelmi-nyilatkozat" },
  ]),
];

const lastUpdated = "2025-06-01";
---

<BaseLayout
  title="Adatvédelmi nyilatkozat | Konvertalo.hu"
  description="A Konvertalo.hu adatvédelmi nyilatkozata és cookie (süti) szabályzata. Minden feldolgozás a böngészőben történik, nem gyűjtünk személyes adatokat."
  canonical="/adatvedelmi-nyilatkozat"
  schemaScripts={schemas}
>

  <div class="legal-page container">
    <header class="legal-header">
      <nav class="legal-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Főoldal</a>
        <span aria-hidden="true">›</span>
        <span>Adatvédelmi nyilatkozat</span>
      </nav>
      <h1 class="legal-title">Adatvédelmi nyilatkozat</h1>
      <p class="legal-updated">Utolsó frissítés: {lastUpdated}</p>
    </header>

    <div class="legal-body">

      <!-- Összefoglaló -->
      <section class="legal-section">
        <div class="legal-highlight">
          <span class="legal-highlight__icon" aria-hidden="true">🔒</span>
          <div>
            <strong>Röviden:</strong> A {SITE_NAME} minden eszköze a böngésződben fut. Nem töltünk fel fájlokat szerverre, nem gyűjtünk személyes adatokat, és nem használunk nyomkövető cookie-kat. Az adatvédelem a rendszer alapja, nem opció.
          </div>
        </div>
      </section>

      <!-- 1. Adatkezelő -->
      <section class="legal-section">
        <h2 class="legal-section__title" id="adatkezelo">1. Az adatkezelő</h2>
        <p>Az adatkezelő: <strong>Mészáros János</strong></p>
        <ul>
          <li>Weboldal: <a href={SITE_URL}>{SITE_NAME}</a></li>
          <li>E-mail: <a href="mailto:info@konvertalo.hu">info@konvertalo.hu</a></li>
        </ul>
      </section>

      <!-- 2. Adatfeldolgozási elvek -->
      <section class="legal-section">
        <h2 class="legal-section__title" id="adatfeldolgozas">2. Adatfeldolgozási elvek</h2>
        <p>A {SITE_NAME} <strong>kliens oldali feldolgozást</strong> alkalmaz. Ez azt jelenti:</p>
        <ul>
          <li>A feltöltött fájlok kizárólag a böngésződben kerülnek feldolgozásra (JavaScript/Web Worker).</li>
          <li>Egyetlen fájl sem hagyja el a készülékedet – nincs szerverre küldés.</li>
          <li>Nem tárolunk feltöltött fájlokat, konverziós eredményeket vagy fájlneveket.</li>
          <li>Az oldal bezárása után semmilyen fájladat nem marad a rendszerünkben.</li>
        </ul>
      </section>

      <!-- 3. Személyes adatok -->
      <section class="legal-section">
        <h2 class="legal-section__title" id="szemelyes-adatok">3. Személyes adatok</h2>
        <p>A {SITE_NAME} az alábbi esetekben kezelhet személyes adatokat:</p>

        <h3 class="legal-subsection">3.1. Kapcsolatfelvételi űrlap</h3>
        <p>A <a href="/kapcsolat">kapcsolat oldalon</a> megadott adatokat (név, e-mail cím, üzenet) kizárólag a megkeresés megválaszolásához használjuk. Az adatokat a Netlify Forms szolgáltatás továbbítja számunkra, azokat legfeljebb 12 hónapig őrizzük, majd töröljük.</p>

        <h3 class="legal-subsection">3.2. Analitika</h3>
        <p>Az oldal <strong>Google Analytics 4 (GA4)</strong> szolgáltatást használja a látogatottsági adatok mérésére. A GA4:</p>
        <ul>
          <li>Anonimizált, összesített statisztikákat gyűjt (oldalmegtekintések, hivatkozó oldalak, országok)</li>
          <li>Cookie-kat használhat a munkamenet azonosítására (lásd cookie szabályzat)</li>
          <li>Az IP-címek anonimizálva kerülnek feldolgozásra</li>
          <li>A Google Consent Mode v2-vel működik együtt a GDPR-megfelelőség érdekében</li>
        </ul>
        <p>Részletek: <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Google Adatvédelmi irányelvek</a>. A Google Analytics letiltásához használd a <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Google Analytics Opt-out böngészőbővítményt</a>.</p>
      </section>

      <!-- 4. Cookie (süti) szabályzat -->
      <section class="legal-section">
        <h2 class="legal-section__title" id="cookie-szabalyzat">4. Cookie (süti) szabályzat</h2>
        <p>A {SITE_NAME} minimális cookie-használatot alkalmaz.</p>

        <div class="cookie-table-wrap">
          <table class="cookie-table">
            <thead>
              <tr>
                <th>Cookie neve</th>
                <th>Típus</th>
                <th>Célja</th>
                <th>Lejárat</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>theme</code></td>
                <td>Funkcionális</td>
                <td>Sötét/világos téma beállítás megjegyzése</td>
                <td>localStorage (nem jár le)</td>
              </tr>
              <tr>
                <td><code>_ga</code></td>
                <td>Analitika</td>
                <td>Google Analytics – egyedi látogatók megkülönböztetése</td>
                <td>2 év</td>
              </tr>
              <tr>
                <td><code>_ga_*</code></td>
                <td>Analitika</td>
                <td>Google Analytics 4 – munkamenet állapot tárolása</td>
                <td>2 év</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 class="legal-subsection">Amit NEM használunk:</h3>
        <ul class="legal-no-list">
          <li><span class="legal-no" aria-hidden="true">✕</span> Harmadik féltől származó marketing cookie-k</li>
          <li><span class="legal-no" aria-hidden="true">✕</span> Retargeting / remarketing pixelek</li>
          <li><span class="legal-no" aria-hidden="true">✕</span> Social media tracking</li>
          <li><span class="legal-no" aria-hidden="true">✕</span> Személyre szabott hirdetési cookie-k</li>
        </ul>
        <p class="legal-note">A Google Analytics cookie-k a Consent Mode v2 bekapcsolása esetén csak a felhasználó beleegyezése után aktiválódnak.</p>
      </section>

      <!-- 5. Harmadik féltől származó szolgáltatások -->
      <section class="legal-section">
        <h2 class="legal-section__title" id="harmadik-fel">5. Harmadik féltől származó szolgáltatások</h2>
        <div class="cookie-table-wrap">
          <table class="cookie-table">
            <thead>
              <tr>
                <th>Szolgáltatás</th>
                <th>Cél</th>
                <th>Adatvédelmi link</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Netlify</td>
                <td>Hosting, form feldolgozás</td>
                <td><a href="https://www.netlify.com/privacy/" target="_blank" rel="noopener">netlify.com/privacy</a></td>
              </tr>
              <tr>
                <td>Google Analytics 4</td>
                <td>Látogatottsági statisztikák</td>
                <td><a href="https://policies.google.com/privacy" target="_blank" rel="noopener">policies.google.com/privacy</a></td>
              </tr>
              <tr>
                <td>Google Fonts</td>
                <td>Betűtípus betöltés</td>
                <td><a href="https://policies.google.com/privacy" target="_blank" rel="noopener">policies.google.com/privacy</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 6. Adatbiztonság -->
      <section class="legal-section">
        <h2 class="legal-section__title" id="adatbiztonsag">6. Adatbiztonság</h2>
        <ul>
          <li>Az oldal HTTPS (TLS) titkosítást használ.</li>
          <li>Kliens oldali feldolgozás – a fájlok nem érintik a szervert.</li>
          <li>Nincs felhasználói adatbázis, nincs regisztráció, nincs belépés.</li>
          <li>A forráskód statikusan generált (Astro SSG), minimális támadási felülettel.</li>
        </ul>
      </section>

      <!-- 7. Jogaid -->
      <section class="legal-section">
        <h2 class="legal-section__title" id="jogaid">7. Az érintett jogai (GDPR)</h2>
        <p>Az EU általános adatvédelmi rendelete (GDPR) alapján az alábbi jogok illetnek meg:</p>
        <ul>
          <li><strong>Hozzáférés joga:</strong> Kérheted a kezelt személyes adataid másolatát.</li>
          <li><strong>Helyesbítés joga:</strong> Kérheted pontatlan adataid javítását.</li>
          <li><strong>Törlés joga:</strong> Kérheted személyes adataid törlését.</li>
          <li><strong>Tiltakozás joga:</strong> Tiltakozhatsz az adatkezelés ellen.</li>
          <li><strong>Adathordozhatóság:</strong> Kérheted adataid géppel olvasható formátumban.</li>
        </ul>
        <p>Jogaid gyakorlásához írj a <a href="mailto:info@konvertalo.hu">info@konvertalo.hu</a> címre.</p>
        <p>Panasz esetén a Nemzeti Adatvédelmi és Információszabadság Hatósághoz (NAIH) is fordulhatsz: <a href="https://www.naih.hu" target="_blank" rel="noopener">naih.hu</a></p>
      </section>

      <!-- 8. Módosítások -->
      <section class="legal-section">
        <h2 class="legal-section__title" id="modositasok">8. A nyilatkozat módosítása</h2>
        <p>Fenntartjuk a jogot az adatvédelmi nyilatkozat módosítására. A változásokról ezen az oldalon tájékoztatunk, a frissítés dátumát a dokumentum elején jelezzük.</p>
      </section>

    </div>
  </div>

</BaseLayout>

<style>
/* ─── Legal page layout ──────────────────────────────────── */
.legal-page {
  padding: var(--sp-12) 0 var(--sp-16);
  max-width: 800px;
}

.legal-breadcrumb {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-subtle);
  margin-bottom: var(--sp-6);
}
.legal-breadcrumb a {
  color: var(--text-muted);
  text-decoration: none;
}
.legal-breadcrumb a:hover { color: var(--accent); }

.legal-title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  letter-spacing: -0.02em;
  margin-bottom: var(--sp-2);
}

.legal-updated {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-subtle);
}

.legal-body {
  margin-top: var(--sp-10);
  display: flex;
  flex-direction: column;
  gap: var(--sp-10);
}

/* Highlight box */
.legal-highlight {
  display: flex;
  gap: var(--sp-4);
  padding: var(--sp-5) var(--sp-6);
  background: var(--accent-subtle);
  border: 1px solid var(--accent)30;
  border-left: 4px solid var(--accent);
  border-radius: var(--r-md);
  font-size: 0.9375rem;
  line-height: 1.7;
  color: var(--text-muted);
}
.legal-highlight strong { color: var(--text); }
.legal-highlight__icon {
  font-size: 1.5rem;
  flex-shrink: 0;
  margin-top: 2px;
}

/* Sections */
.legal-section__title {
  font-size: 1.25rem;
  margin-bottom: var(--sp-4);
  padding-bottom: var(--sp-3);
  border-bottom: 1px solid var(--border);
}

.legal-subsection {
  font-size: 1rem;
  margin-top: var(--sp-5);
  margin-bottom: var(--sp-2);
  color: var(--text);
}

.legal-section p {
  font-size: 0.9375rem;
  line-height: 1.75;
  color: var(--text-muted);
}
.legal-section p + p { margin-top: var(--sp-3); }
.legal-section strong { color: var(--text); }
.legal-section a { color: var(--accent); text-decoration: underline; }
.legal-section a:hover { color: var(--accent-dim); }

.legal-section ul {
  margin-top: var(--sp-3);
  padding-left: var(--sp-6);
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}
.legal-section li {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--text-muted);
}

/* "Not used" list */
.legal-no-list {
  list-style: none;
  padding-left: 0 !important;
}
.legal-no {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  background: var(--error);
  color: #fff;
  border-radius: var(--r-full);
  font-size: 0.65rem;
  font-weight: 700;
  margin-right: var(--sp-2);
  flex-shrink: 0;
}

/* Cookie table */
.cookie-table-wrap {
  margin-top: var(--sp-4);
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: var(--r-md);
}
.cookie-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
}
.cookie-table th {
  background: var(--bg-input);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  text-align: left;
  padding: var(--sp-3) var(--sp-4);
  border-bottom: 1px solid var(--border);
}
.cookie-table td {
  padding: var(--sp-3) var(--sp-4);
  color: var(--text-muted);
  border-bottom: 1px solid var(--border);
  line-height: 1.5;
}
.cookie-table tr:last-child td { border-bottom: 0; }
.cookie-table code {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  background: var(--bg-input);
  padding: 2px 6px;
  border-radius: var(--r-sm);
  color: var(--accent);
}

/* Note */
.legal-note {
  font-size: 0.8125rem;
  color: var(--text-subtle);
  font-style: italic;
  margin-top: var(--sp-3);
  line-height: 1.5;
}
</style>
