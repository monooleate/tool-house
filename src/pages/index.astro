---
// ============================================================
// index.astro – Főoldal
// Tabbed tool directory + SEO content (~1000 szó)
// ============================================================
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolTabs from "../components/home/ToolTabs.svelte";
import {
  CATEGORIES, getAllTools, getActiveToolsCount, getTotalToolsCount,
  getLocalizedCategories, getLocalizedTool,
} from "../lib/tool-registry.ts";
import { t, tpl, CURRENT_LANG } from "../i18n/index.ts";
import {
  websiteSchema, organizationSchema, toolListSchema, SITE_NAME, SITE_DESCRIPTION
} from "../lib/seo.ts";
import { toolUrl, categoryUrl } from "../lib/url-utils.ts";

const localizedCategories = getLocalizedCategories(CURRENT_LANG);
const allTools    = getAllTools().map(t => getLocalizedTool(t, CURRENT_LANG));
const activeTools = allTools.filter(t => t.status === "active");
const activeCount = getActiveToolsCount();
const totalCount  = getTotalToolsCount();
const catCount    = localizedCategories.filter(c => allTools.some(t => t.category === c.id && t.status === "active")).length;
const schemas     = [websiteSchema(), organizationSchema(), toolListSchema(activeTools, t("category.all_tools"))];

// Tab-hoz szükséges serializable adat
const tabCategories = localizedCategories.map(c => ({ id: c.id, label: c.label, icon: c.icon, color: c.color, url: categoryUrl(c.id) }));
const tabTools = allTools.map(t => ({ slug: t.slug, category: t.category, h1: t.h1, description: t.description, status: t.status, url: toolUrl(t) }));
---

<BaseLayout
  title={t("home.title")}
  description={t("home.description")}
  canonical="/"
  schemaScripts={schemas}
>

  <!-- ═══ HERO ═══════════════════════════════════════════════ -->
  <section class="hero container">
    <div class="hero__badge">
      <span class="hero__badge-dot"></span>
      {t("home.hero_badge")}
    </div>
    <h1 class="hero__title">
      {t("home.hero_title_line1")}<br/>
      <span class="hero__accent">{t("home.hero_title_accent")}</span>
    </h1>
    <p class="hero__desc">
      {t("home.hero_desc")}
      <Fragment set:html={" " + t("home.hero_desc2")} />
    </p>
    <div class="hero__stats">
      <div class="hero-stat">
        <span class="hero-stat__num">{activeCount}</span>
        <span class="hero-stat__label">{t("home.stat_active")}</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat__num">{catCount}</span>
        <span class="hero-stat__label">{t("home.stat_category")}</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat__num">0</span>
        <span class="hero-stat__label">{t("home.stat_upload")}</span>
      </div>
    </div>
  </section>

  <!-- ═══ TABBED TOOLS ═══════════════════════════════════════ -->
  <section class="tools-section container" aria-labelledby="tools-title">
    <h2 id="tools-title" class="section-heading">
      <span class="section-heading__icon">🔧</span>
      {t("home.tools_heading")}
    </h2>
    <ToolTabs
      client:visible
      categories={tabCategories}
      tools={tabTools}
    />
  </section>

  <!-- ═══ TRUST / FEATURES ═══════════════════════════════════ -->
  <section class="trust container" aria-labelledby="trust-title">
    <h2 id="trust-title" class="section-heading">
      <span class="section-heading__icon">✨</span>
      {t("home.trust_heading")}
    </h2>
    <div class="trust-grid">
      <div class="trust-card">
        <div class="trust-card__icon">🔒</div>
        <h3 class="trust-card__title">{t("home.trust_private_title")}</h3>
        <p class="trust-card__desc">{t("home.trust_private_desc")}</p>
      </div>
      <div class="trust-card">
        <div class="trust-card__icon">⚡</div>
        <h3 class="trust-card__title">{t("home.trust_fast_title")}</h3>
        <p class="trust-card__desc">{t("home.trust_fast_desc")}</p>
      </div>
      <div class="trust-card">
        <div class="trust-card__icon">🆓</div>
        <h3 class="trust-card__title">{t("home.trust_free_title")}</h3>
        <p class="trust-card__desc">{t("home.trust_free_desc")}</p>
      </div>
      <div class="trust-card">
        <div class="trust-card__icon">🌍</div>
        <h3 class="trust-card__title">{t("home.trust_offline_title")}</h3>
        <p class="trust-card__desc">{t("home.trust_offline_desc")}</p>
      </div>
    </div>
  </section>

  <!-- ═══ SEO CONTENT ════════════════════════════════════════ -->
  <section class="seo-content container" aria-labelledby="about-title">
    <div class="seo-content__inner">

      <article class="seo-block">
        <h2 id="about-title" class="seo-block__title">{t("home.seo_about_title")}</h2>
        <p>{t("home.seo_about_p1")}</p>
        <p><Fragment set:html={tpl("home.seo_about_p2", { active: String(activeCount), catCount: String(catCount), total: String(totalCount) })} /></p>
      </article>

      <article class="seo-block">
        <h2 class="seo-block__title">{t("home.seo_how_title")}</h2>
        <p>{t("home.seo_how_p1")}</p>
        <p>{t("home.seo_how_p2")}</p>
        <p>{t("home.seo_how_p3")}</p>
      </article>

      <article class="seo-block">
        <h2 class="seo-block__title">{t("home.seo_who_title")}</h2>
        <p><Fragment set:html={t("home.seo_who_dev")} /></p>
        <p><Fragment set:html={t("home.seo_who_content")} /></p>
        <p><Fragment set:html={t("home.seo_who_office")} /></p>
        <p><Fragment set:html={t("home.seo_who_privacy")} /></p>
      </article>

      <article class="seo-block">
        <h2 class="seo-block__title">{t("home.seo_faq_title")}</h2>
        <dl class="faq-list">
          <div class="faq-item">
            <dt class="faq-item__q">{t("home.faq_upload_q")}</dt>
            <dd class="faq-item__a">{t("home.faq_upload_a")}</dd>
          </div>
          <div class="faq-item">
            <dt class="faq-item__q">{t("home.faq_free_q")}</dt>
            <dd class="faq-item__a">{t("home.faq_free_a")}</dd>
          </div>
          <div class="faq-item">
            <dt class="faq-item__q">{t("home.faq_browser_q")}</dt>
            <dd class="faq-item__a">{t("home.faq_browser_a")}</dd>
          </div>
          <div class="faq-item">
            <dt class="faq-item__q">{t("home.faq_mobile_q")}</dt>
            <dd class="faq-item__a">{t("home.faq_mobile_a")}</dd>
          </div>
          <div class="faq-item">
            <dt class="faq-item__q">{t("home.faq_batch_q")}</dt>
            <dd class="faq-item__a">{t("home.faq_batch_a")}</dd>
          </div>
        </dl>
      </article>

    </div>
  </section>

  <!-- ═══ CTA ═════════════════════════════════════════════════ -->
  <section class="cta-section container">
    <div class="cta-box">
      <h2 class="cta-box__title">{t("home.cta_title")}</h2>
      <p class="cta-box__desc"><Fragment set:html={tpl("home.cta_desc", { active: String(activeCount) })} /></p>
      <a href="#tools-title" class="btn btn--primary btn--lg cta-box__btn">{t("home.cta_button")}</a>
    </div>
  </section>

</BaseLayout>

<style>
/* ═══ HERO ════════════════════════════════════════════════════ */
.hero {
  padding: var(--sp-16) 0 var(--sp-12);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-5);
}

.hero__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--accent);
  background: var(--accent-subtle);
  border: 1px solid var(--accent)40;
  padding: var(--sp-2) var(--sp-4);
  border-radius: var(--r-full);
}

.hero__badge-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse-dot 2s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.4; transform: scale(0.8); }
}

.hero__title {
  font-size: clamp(2.5rem, 6vw, 4rem);
  line-height: 1.05;
  letter-spacing: -0.03em;
}

.hero__accent {
  color: var(--accent);
  position: relative;
}

.hero__desc {
  font-size: 1.125rem;
  max-width: 54ch;
  text-align: center;
  color: var(--text-muted);
  line-height: 1.6;
}

.hero__stats {
  display: flex;
  gap: var(--sp-8);
  justify-content: center;
  flex-wrap: wrap;
  margin-top: var(--sp-4);
}

.hero-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.hero-stat__num {
  font-family: var(--font-mono);
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--text);
  line-height: 1;
}

.hero-stat__label {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-subtle);
}

/* ═══ SECTION HEADING ════════════════════════════════════════ */
.section-heading {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  font-size: 1.375rem;
  margin-bottom: var(--sp-6);
}

.section-heading__icon {
  font-size: 1.25rem;
}

/* ═══ TOOLS SECTION ══════════════════════════════════════════ */
.tools-section {
  margin-bottom: var(--sp-16);
}

/* ═══ TRUST GRID ═════════════════════════════════════════════ */
.trust {
  margin-bottom: var(--sp-16);
}

.trust-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: var(--sp-4);
}

.trust-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp-6);
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  transition: all 180ms ease;
}

.trust-card:hover {
  border-color: var(--accent)60;
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0,0,0,0.08);
}

.trust-card__icon { font-size: 2rem; }
.trust-card__title { font-size: 1rem; }
.trust-card__desc {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.6;
  max-width: none;
}

/* ═══ SEO CONTENT ════════════════════════════════════════════ */
.seo-content {
  margin-bottom: var(--sp-16);
}

.seo-content__inner {
  max-width: 75ch;
  display: flex;
  flex-direction: column;
  gap: var(--sp-10);
}

.seo-block__title {
  font-size: 1.25rem;
  margin-bottom: var(--sp-4);
  padding-bottom: var(--sp-3);
  border-bottom: 1px solid var(--border);
}

.seo-block p {
  font-size: 0.9375rem;
  line-height: 1.75;
  color: var(--text-muted);
}

.seo-block p + p {
  margin-top: var(--sp-3);
}

.seo-block strong {
  color: var(--text);
}

/* FAQ */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.faq-item {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  padding: var(--sp-4) var(--sp-5);
}

.faq-item__q {
  font-family: var(--font-mono);
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: var(--sp-2);
}

.faq-item__a {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin: 0;
}

/* ═══ CTA ZÁRÓ ═══════════════════════════════════════════════ */
.cta-section {
  margin-bottom: var(--sp-16);
}

.cta-box {
  text-align: center;
  padding: var(--sp-10) var(--sp-8);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  position: relative;
  overflow: hidden;
}

.cta-box::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--accent), #3b82f6, #8b5cf6, var(--accent));
  background-size: 200% 100%;
  animation: gradient-slide 4s linear infinite;
}

@keyframes gradient-slide {
  0%   { background-position: 0% 0%; }
  100% { background-position: 200% 0%; }
}

.cta-box__title {
  font-size: 1.375rem;
  margin-bottom: var(--sp-3);
}

.cta-box__desc {
  color: var(--text-muted);
  margin-bottom: var(--sp-5);
  max-width: none;
}

.cta-box__btn {
  font-family: var(--font-mono);
  font-weight: 700;
}
</style>
