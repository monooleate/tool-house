---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ImageConvertTool from "../../components/tools/shared/ImageConvertTool.svelte";
import { getToolBySlug } from "../../lib/tool-registry.ts";
const tool = getToolBySlug("kep", "jpg-png")!;
---
<ToolLayout tool={tool}>
  <ImageConvertTool client:visible acceptFormats="image/jpeg,.jpg,.jpeg" acceptLabel="JPG" outputFormat="image/png" outputExt="png" showQuality={false} zipName="png-kepek.zip" toolSlug="jpg-png" convertLabel="PNG konvertálás" downloadLabel="PNG letöltése" />
</ToolLayout>
