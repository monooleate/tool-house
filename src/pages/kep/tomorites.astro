---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ImageConvertTool from "../../components/tools/shared/ImageConvertTool.svelte";
import { getToolBySlug } from "../../lib/tool-registry.ts";
const tool = getToolBySlug("kep", "tomorites")!;
---
<ToolLayout tool={tool}>
  <ImageConvertTool client:visible acceptFormats="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" acceptLabel="JPG, PNG, WebP" outputFormat="image/webp" outputExt="webp" showQuality={true} defaultQuality={75} zipName="tomorites-kepek.zip" toolSlug="tomorites" convertLabel="Tömörítés" downloadLabel="Tömörített letöltése" />
</ToolLayout>
