---
import ToolLayout from "../../layouts/ToolLayout.astro";
import ImageConvertTool from "../../components/tools/shared/ImageConvertTool.svelte";
import { getToolBySlug } from "../../lib/tool-registry.ts";
const tool = getToolBySlug("kep", "webp-png")!;
---
<ToolLayout tool={tool}>
  <ImageConvertTool client:visible acceptFormats="image/webp,.webp" acceptLabel="WebP" outputFormat="image/png" outputExt="png" showQuality={false} zipName="png-kepek.zip" toolSlug="webp-png" convertLabel="PNG konvertálás" downloadLabel="PNG letöltése" />
</ToolLayout>
