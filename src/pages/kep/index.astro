---
import CategoryLayout from "../../layouts/CategoryLayout.astro";
import { getCategoryInfo, getToolsByCategory } from "../../lib/tool-registry.ts";

const category = getCategoryInfo("kep")!;
const tools = getToolsByCategory("kep");
---

<CategoryLayout
  category={category}
  tools={tools}
  title="Kép eszközök online | Ingyenes képkonverter, tömörítő"
  description="Ingyenes online képeszközök: JPG→WebP, PNG, tömörítés, átméretezés, forgatás – mind böngészőben, szerver nélkül."
/>
