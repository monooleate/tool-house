---
// ============================================================
// BaseLayout.astro
// Alap layout: HTML skeleton, SEO meta, dark mode, nav, footer
// ============================================================
import "../styles/global.css";
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL, buildCanonical } from "../lib/seo.ts";
import { CATEGORIES, getActiveToolsCount, getTotalToolsCount, getToolsByCategory, getVisibleCategories, getLocalizedCategory, getLocalizedTool } from "../lib/tool-registry.ts";
import { toolUrl, categoryUrl, staticUrl } from "../lib/url-utils.ts";
import { GOOGLE_TAG_ID, GTM_ID, CONSENT_MODE_ENABLED, hasGoogleTag, hasGTM } from "../lib/analytics.ts";
import { t, tpl, CURRENT_CONFIG, CURRENT_LANG, LANG_CONFIG } from "../i18n/index.ts";
import type { SupportedLang } from "../i18n/index.ts";

const localizedCategories = getVisibleCategories(CURRENT_LANG).map(cat => getLocalizedCategory(cat, CURRENT_LANG));
const { siteName, siteUrl, siteNameShort, lang: htmlLang, locale } = CURRENT_CONFIG;
// View Transitions kikapcsolva – link navigáció hibát okozott
// import { ViewTransitions } from "astro:transitions";
import SearchOverlay from "../components/ui/SearchOverlay.svelte";

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: "website" | "article";
  schemaScripts?: string[];  // JSON-LD stringek tömbje
  hreflangPaths?: { hu: string; ro: string };
  noIndex?: boolean;
  publishedAt?: string;
  modifiedAt?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonical,
  ogTitle,
  ogDescription,
  ogImage      = "/og-default.png",
  ogImageWidth  = 1200,
  ogImageHeight = 630,
  ogType        = "website",
  schemaScripts = [],
  hreflangPaths,
  noIndex       = false,
  publishedAt,
  modifiedAt,
} = Astro.props;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `${SITE_URL.replace(/\/$/, "")}${ogImage}`;
const hasLargeOgImage = ogImageWidth >= 300 && ogImageHeight >= 157;

const canonicalUrl = buildCanonical(canonical ?? Astro.url.pathname);
const resolvedTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const activeCount = getActiveToolsCount();
const totalCount = getTotalToolsCount();
---

<!doctype html>
<html lang={htmlLang} class="no-js" dir={CURRENT_CONFIG.dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Primary SEO -->
  <title>{resolvedTitle}</title>
  <meta name="description" content={description} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- llms.txt: AI crawler discovery -->
  <link rel="alternate" type="text/plain" href={`${siteUrl}/llms.txt`} title="LLMs.txt" />

  <!-- hreflang: language alternates -->
  {(() => {
    const huPath = hreflangPaths?.hu ?? (canonical ?? Astro.url.pathname);
    const roPath = hreflangPaths?.ro ?? (canonical ?? Astro.url.pathname);
    return (
      <>
        <link rel="alternate" hreflang="hu" href={`https://konvertalo.hu${huPath}`} />
        <link rel="alternate" hreflang="ro" href={`https://instrumenteonline.ro${roPath}`} />
        <link rel="alternate" hreflang="x-default" href={`https://konvertalo.hu${huPath}`} />
      </>
    );
  })()}

  <!-- Open Graph -->
  <meta property="og:type"         content={ogType} />
  <meta property="og:site_name"    content={SITE_NAME} />
  <meta property="og:locale"       content={locale} />
  <meta property="og:title"        content={ogTitle ?? resolvedTitle} />
  <meta property="og:description"  content={ogDescription ?? description} />
  <meta property="og:url"          content={canonicalUrl} />
  <meta property="og:image"        content={ogImageAbsolute} />
  <meta property="og:image:width"  content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />
  <meta property="og:image:alt"    content={ogTitle ?? resolvedTitle} />

  <!-- OG Article (cikkekhez) -->
  {ogType === "article" && publishedAt && <meta property="article:published_time" content={publishedAt} />}
  {ogType === "article" && modifiedAt  && <meta property="article:modified_time"  content={modifiedAt} />}
  {ogType === "article" && <meta property="article:author" content={SITE_NAME} />}

  <!-- Twitter Card -->
  <meta name="twitter:card"        content={hasLargeOgImage ? "summary_large_image" : "summary"} />
  <meta name="twitter:site"        content="@jmeszarosdev" />
  <meta name="twitter:creator"     content="@jmeszarosdev" />
  <meta name="twitter:title"       content={ogTitle ?? resolvedTitle} />
  <meta name="twitter:description" content={ogDescription ?? description} />
  <meta name="twitter:image"       content={ogImageAbsolute} />
  <meta name="twitter:image:alt"   content={ogTitle ?? resolvedTitle} />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f0" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)"  content="#0f0f0e" />

  <!-- Preconnect + Font loading (display=optional → zero CLS) -->
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Figtree:wght@400;500;600;700&display=optional"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Figtree:wght@400;500;600;700&display=optional" />
  </noscript>

  <!-- View Transitions kikapcsolva – link navigáció hibát okozott -->
  <!-- <ViewTransitions fallback="none" /> -->

  <!-- JSON-LD Schemas -->
  {schemaScripts.map((schema) => (
    <script type="application/ld+json" set:html={schema} />
  ))}

  <!-- Google Tag Manager (head) – csak production -->
  {import.meta.env.PROD && hasGTM() && (
    <script is:inline define:vars={{ GTM_ID, CONSENT_MODE_ENABLED }}>
      // Consent Mode v2 defaults (GDPR)
      if (CONSENT_MODE_ENABLED) {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          personalization_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500
        });
        // Korábbi consent visszaállítása
        try {
          if (localStorage.getItem('cookie_consent') === 'granted') {
            gtag('consent', 'update', {
              ad_storage: 'granted', ad_user_data: 'granted',
              ad_personalization: 'granted', analytics_storage: 'granted'
            });
          }
        } catch(e) {}
      }
      // GTM snippet
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',GTM_ID);
    </script>
  )}

  <!-- Google Analytics 4 (gtag.js) – csak production, késleltetett betöltés -->
  {import.meta.env.PROD && hasGoogleTag() && !hasGTM() && (
    <script is:inline define:vars={{ GOOGLE_TAG_ID, CONSENT_MODE_ENABLED }}>
      // Consent Mode v2 defaults – azonnal beállítjuk (nem blokkoló)
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      if (CONSENT_MODE_ENABLED) {
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          personalization_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500
        });
        try {
          if (localStorage.getItem('cookie_consent') === 'granted') {
            gtag('consent', 'update', {
              ad_storage: 'granted', ad_user_data: 'granted',
              ad_personalization: 'granted', analytics_storage: 'granted'
            });
          }
        } catch(e) {}
      }

      // Késleltetett gtag.js betöltés – ne blokkolja a fő szálat
      function loadGtag() {
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GOOGLE_TAG_ID;
        s.async = true;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', GOOGLE_TAG_ID, {
          send_page_view: true,
          cookie_flags: 'SameSite=None;Secure'
        });
      }
      // requestIdleCallback-kel vagy 2.5s késleltetéssel
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGtag, { timeout: 3000 });
      } else {
        setTimeout(loadGtag, 2500);
      }
    </script>
  )}

  <!-- Inline dark mode script (FOUC prevention) -->
  <script is:inline>
    (function() {
      try {
        var stored = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var html = document.documentElement;
        html.classList.remove("no-js");
        if (stored === "dark" || (!stored && prefersDark)) {
          html.classList.add("dark");
        } else {
          html.classList.add("light");
        }
      } catch(e) {}
    })();
  </script>

  <!-- Google AdSense – csak ha Publisher ID be van állítva -->
  {(() => {
    const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID ?? '';
    return adsenseClient.length > 0 ? true : false;
  })() && (
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT_ID}`}
      crossorigin="anonymous"
    ></script>
  )}
</head>

<body>

  <!-- GTM noscript fallback – csak production -->
  {import.meta.env.PROD && hasGTM() && (
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
  )}

  <!-- Skip link -->
  <a href="#main-content" class="sr-only skip-link">{t("nav.skip_to_content")}</a>

  <!-- Navigation -->
  <header class="site-header" role="banner">
    <nav class="site-nav container" aria-label={t("nav.main_nav")}>
      <a href="/" class="site-logo" aria-label={`${SITE_NAME} ${t("nav.home_label")}`}>
        <span class="site-logo__icon" aria-hidden="true">⚡</span>
        <span class="site-logo__text site-logo__text--full">{SITE_NAME}</span>
        <span class="site-logo__text site-logo__text--short">{siteNameShort}</span>
        <span class="site-logo__count" title={tpl("nav.active_tools_title", { count: String(activeCount) })}>{activeCount}</span>
      </a>

      <!-- Category nav with mega-menu dropdowns -->
      <ul class="nav-cats" role="list">
        {localizedCategories.map((cat) => {
          const catTools = getToolsByCategory(cat.id).map(t => getLocalizedTool(t, CURRENT_LANG));
          const activeTools = catTools.filter(t => t.status === "active");
          const comingTools = catTools.filter(t => t.status === "coming-soon");
          return (
            <li class="nav-cat-item">
              <a href={categoryUrl(cat.id)} class="nav-cat-link" style={`--cat-color: ${cat.color}`}>
                <span aria-hidden="true">{cat.icon}</span>
                <span class="nav-cat-label">{cat.label}</span>
              </a>

              {/* Mega-menu dropdown */}
              <div class="mega-dropdown">
                <div class="mega-dropdown__header">
                  <span class="mega-dropdown__icon">{cat.icon}</span>
                  <div>
                    <a href={categoryUrl(cat.id)} class="mega-dropdown__title">{cat.label}</a>
                    <p class="mega-dropdown__desc">{cat.description}</p>
                  </div>
                </div>

                <div class="mega-dropdown__body">
                  {activeTools.length > 0 && (
                    <div class="mega-dropdown__section">
                      <span class="mega-dropdown__label">{t("nav.available_tools")}</span>
                      <ul class="mega-dropdown__list">
                        {activeTools.map(tool => (
                          <li>
                            <a href={toolUrl(tool)} class="mega-tool mega-tool--active">
                              <span class="mega-tool__name">{tool.h1}</span>
                              <span class="mega-tool__arrow">→</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {comingTools.length > 0 && (
                    <div class="mega-dropdown__section">
                      <span class="mega-dropdown__label mega-dropdown__label--dim">{tpl("nav.coming_soon_count", { count: String(comingTools.length) })}</span>
                      <ul class="mega-dropdown__list mega-dropdown__list--coming">
                        {comingTools.slice(0, 4).map(tool => (
                          <li>
                            <a href={toolUrl(tool)} class="mega-tool mega-tool--coming">
                              <span class="mega-tool__name">{tool.h1}</span>
                            </a>
                          </li>
                        ))}
                        {comingTools.length > 4 && (
                          <li>
                            <a href={categoryUrl(cat.id)} class="mega-tool mega-tool--more">
                              {tpl("nav.more_tools", { count: String(comingTools.length - 4) })}
                            </a>
                          </li>
                        )}
                      </ul>
                    </div>
                  )}
                </div>

                <a href={categoryUrl(cat.id)} class="mega-dropdown__viewall">
                  {tpl("nav.view_all_tools", { label: cat.label.toLowerCase() })}
                </a>
              </div>
            </li>
          );
        })}
      </ul>

      <!-- Right controls -->
      <div class="nav-controls">
        <!-- Search -->
        <button
          class="btn btn--ghost btn--sm nav-search-btn"
          aria-label={t("nav.search_label")}
          id="search-trigger"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <span class="nav-search-label">{t("nav.search_text")}</span>
        </button>

        <!-- Dark mode toggle -->
        <button
          class="btn btn--ghost btn--sm theme-toggle"
          id="theme-toggle"
          aria-label={t("nav.theme_toggle")}
          title={t("nav.theme_toggle")}
        >
          <span class="theme-icon theme-icon--sun" aria-hidden="true">☀️</span>
          <span class="theme-icon theme-icon--moon" aria-hidden="true">🌙</span>
        </button>

        <!-- Mobile hamburger -->
        <button
          class="btn btn--ghost btn--sm mobile-menu-btn"
          id="mobile-menu-toggle"
          aria-label={t("nav.menu_open")}
          aria-expanded="false"
          aria-controls="mobile-drawer"
          data-open-label={t("nav.menu_open")}
          data-close-label={t("nav.menu_close")}
        >
          <svg class="hamburger-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" class="ham-top"/>
            <line x1="3" y1="12" x2="21" y2="12" class="ham-mid"/>
            <line x1="3" y1="18" x2="21" y2="18" class="ham-bot"/>
          </svg>
        </button>
      </div>
    </nav>
  </header>

  <!-- Mobile drawer overlay -->
  <div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>
  <aside class="mobile-drawer" id="mobile-drawer" aria-label={t("nav.mobile_menu")} aria-hidden="true">
    <div class="mobile-drawer__header">
      <span class="mobile-drawer__title">{t("nav.categories")}</span>
      <button class="btn btn--ghost btn--sm mobile-drawer__close" id="mobile-drawer-close" aria-label={t("nav.menu_close")}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <nav class="mobile-drawer__nav">
      <ul class="mobile-drawer__list" role="list">
        {localizedCategories.map((cat) => {
          const catTools = getToolsByCategory(cat.id);
          const activeCount = catTools.filter(t => t.status === "active").length;
          return (
            <li>
              <a href={categoryUrl(cat.id)} class="mobile-drawer__link" style={`--cat-color: ${cat.color}`}>
                <span class="mobile-drawer__icon" aria-hidden="true">{cat.icon}</span>
                <span class="mobile-drawer__label">{cat.label}</span>
                <span class="mobile-drawer__count">{activeCount}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="mobile-drawer__footer">
      <a href={staticUrl("kereses")} class="mobile-drawer__search-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        {t("nav.search_tools_link")}
      </a>
    </div>
  </aside>

  <!-- Main content -->
  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <!-- Search overlay (Svelte island – client-only, no SSR) -->
  <SearchOverlay client:only="svelte" labels={{
    dialog_label: t("search.dialog_label"),
    placeholder: t("search.placeholder"),
    input_label: t("search.input_label"),
    close: t("search.close"),
    results_label: t("search.results_label"),
    no_results: t("search.no_results"),
    coming_soon: t("search.coming_soon"),
    nav_hint: t("search.nav_hint"),
    open_hint: t("search.open_hint"),
    close_hint: t("search.close_hint"),
    tools_count: t("search.tools_count"),
  }} />

  <!-- Footer -->
  <footer class="site-footer" role="contentinfo">
    <div class="container site-footer__inner">
      <div class="site-footer__brand">
        <a href="/" class="site-logo">
          <span aria-hidden="true">⚡</span>
          {SITE_NAME}
        </a>
        <p class="site-footer__tagline">
          {tpl("footer.tagline", { count: String(totalCount) })}
        </p>
      </div>

      <nav class="site-footer__nav" aria-label={t("nav.tool_categories")}>
        {localizedCategories.map((cat) => (
          <div class="footer-cat">
            <a href={categoryUrl(cat.id)} class="footer-cat__title">
              {cat.icon} {cat.label}
            </a>
          </div>
        ))}
      </nav>

      {/* Cross-language links – dinamikusan a LANG_CONFIG-ból */}
      {(() => {
        const otherLangs = (Object.keys(LANG_CONFIG) as SupportedLang[]).filter(l => l !== CURRENT_LANG);
        if (otherLangs.length === 0) return null;
        return (
          <div class="site-footer__langs">
            <span class="footer-langs__label">{t("footer.also_available")}</span>
            <div class="footer-langs__list">
              {otherLangs.map(lang => {
                const cfg = LANG_CONFIG[lang];
                const langPath = hreflangPaths?.[lang] ?? "/";
                const fullUrl = `${cfg.siteUrl}${langPath}`;
                return (
                  <a href={fullUrl} class="footer-lang-link" hreflang={lang} rel="alternate">
                    <span class="footer-lang-link__flag" aria-hidden="true">{cfg.flag}</span>
                    <span class="footer-lang-link__name">{cfg.nativeName}</span>
                    <span class="footer-lang-link__site">{cfg.siteName}</span>
                    <span class="footer-lang-link__arrow" aria-hidden="true">→</span>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })()}

      <div class="site-footer__meta">
        <p class="text-subtle">
          © {new Date().getFullYear()} {siteName} · {t("footer.copyright")}
        </p>
        <nav aria-label={t("nav.legal_links")}>
          <a href={staticUrl("rolunk")}>{t("nav.about")}</a>
          <a href={staticUrl("kapcsolat")}>{t("nav.contact")}</a>
          <a href={staticUrl("adatvedelmi")}>{t("footer.privacy")}</a>
          <a href={staticUrl("aszf")}>{t("footer.tos")}</a>
          <a href="/sitemap.xml">{t("footer.sitemap")}</a>
        </nav>
      </div>
    </div>
  </footer>

  <!-- Cookie consent banner – csak ha CONSENT_MODE_ENABLED -->
  {CONSENT_MODE_ENABLED && (
    <div class="cookie-banner" id="cookie-banner" role="dialog" aria-label={t("cookie.label")} aria-hidden="true">
      <div class="cookie-banner__inner">
        <div class="cookie-banner__content">
          <p class="cookie-banner__text">
            <strong>{t("cookie.title")}</strong>
            {t("cookie.text")}
            <a href={`${staticUrl("adatvedelmi")}#cookie-szabalyzat`} class="cookie-banner__link">{t("cookie.details")}</a>
          </p>
        </div>
        <div class="cookie-banner__actions">
          <button class="btn btn--ghost btn--sm cookie-banner__reject" id="cookie-reject">
            {t("cookie.reject")}
          </button>
          <button class="btn btn--primary btn--sm cookie-banner__accept" id="cookie-accept">
            {t("cookie.accept")}
          </button>
        </div>
      </div>
    </div>
  )}

</body>
</html>

<style>
/* ─── Site Header ─────────────────────────────────────────── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.site-nav {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  height: 56px;
}

/* Logo */
.site-logo {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 1.125rem;
  color: var(--text);
  text-decoration: none;
  flex-shrink: 0;
}
.site-logo:hover { color: var(--accent); }

.site-logo__icon { font-size: 1.25rem; }
.site-logo__text { color: inherit; }
.site-logo__text--short { display: none; }
@media (max-width: 480px) {
  .site-logo__text--full { display: none; }
  .site-logo__text--short { display: inline; }
}

.site-logo__count {
  font-size: 0.65rem;
  background: var(--accent-bright);
  color: #000;
  padding: 1px 5px;
  border-radius: var(--r-full);
  font-weight: 700;
  vertical-align: super;
}

/* Category nav */
.nav-cats {
  display: flex;
  align-items: center;
  gap: 2px;
  list-style: none;
  margin: 0;
  padding: 0;
  flex: 1;
  overflow: visible;
  scrollbar-width: none;
}
.nav-cats::-webkit-scrollbar { display: none; }

/* Mobile: horizontal scroll, no mega-menu */
@media (max-width: 768px) {
  .nav-cats {
    overflow-x: auto;
    overflow-y: visible;
  }
}

.nav-cat-item {
  position: relative;
}

.nav-cat-link {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--text-muted);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  text-decoration: none;
  transition: all var(--t-fast);
  white-space: nowrap;
  border-bottom: 2px solid transparent;
}

.nav-cat-link:hover {
  color: var(--cat-color, var(--accent));
  background: var(--accent-subtle);
  border-bottom-color: var(--cat-color, var(--accent));
}

.nav-cat-label {
  display: none;
}

@media (min-width: 900px) {
  .nav-cat-label { display: inline; }
}

/* ─── Mega dropdown ─────────────────────────────────────────── */
.mega-dropdown {
  display: none;
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  min-width: 280px;
  max-width: 340px;
  max-height: min(70vh, 560px);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  box-shadow: 0 12px 40px rgba(0,0,0,0.18), 0 0 0 1px rgba(255,255,255,0.04);
  padding: 0;
  z-index: 200;
  overflow: hidden;
  animation: mega-in 150ms cubic-bezier(0.16, 1, 0.3, 1);
  flex-direction: column;
}
.nav-cat-item:hover .mega-dropdown {
  display: flex;
}

.mega-dropdown__body {
  overflow-y: auto;
  flex: 1;
  min-height: 0;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}
.mega-dropdown__body::-webkit-scrollbar { width: 5px; }
.mega-dropdown__body::-webkit-scrollbar-track { background: transparent; }
.mega-dropdown__body::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 4px;
}
.mega-dropdown__body::-webkit-scrollbar-thumb:hover {
  background: var(--text-subtle);
}

@keyframes mega-in {
  from { opacity: 0; transform: translateX(-50%) translateY(-6px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* Invisible bridge so hover doesn't break between link and dropdown */
.nav-cat-item::after {
  content: "";
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  height: 8px;
}

.nav-cat-item:hover::after {
  display: block;
}

/* Dropdown header */
.mega-dropdown__header {
  display: flex;
  gap: var(--sp-3);
  align-items: flex-start;
  padding: var(--sp-4) var(--sp-5);
  border-bottom: 1px solid var(--border);
  background: var(--bg-input);
}

.mega-dropdown__icon {
  font-size: 1.5rem;
  flex-shrink: 0;
  line-height: 1;
}

.mega-dropdown__title {
  font-family: var(--font-mono);
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--text);
  text-decoration: none;
  display: block;
}
.mega-dropdown__title:hover { color: var(--accent); }

.mega-dropdown__desc {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin: 2px 0 0;
  line-height: 1.4;
}

/* Sections */
.mega-dropdown__section {
  padding: var(--sp-3) var(--sp-4);
}

.mega-dropdown__label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent);
  padding: 0 var(--sp-1);
  margin-bottom: var(--sp-2);
}

.mega-dropdown__label--dim {
  color: var(--text-subtle);
}

.mega-dropdown__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

/* Tool items */
.mega-tool {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  text-decoration: none;
  transition: all var(--t-fast);
  font-size: 0.8125rem;
}

.mega-tool--active {
  color: var(--text);
}
.mega-tool--active:hover {
  background: var(--accent-subtle);
  color: var(--accent);
}

.mega-tool__name {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mega-tool__arrow {
  font-family: var(--font-mono);
  color: var(--accent);
  opacity: 0;
  transition: opacity var(--t-fast);
  flex-shrink: 0;
}

.mega-tool--active:hover .mega-tool__arrow {
  opacity: 1;
}

.mega-tool--coming {
  color: var(--text-subtle);
  opacity: 0.6;
}
.mega-tool--coming:hover {
  opacity: 0.8;
  background: var(--bg-input);
}

.mega-tool--more {
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
}
.mega-tool--more:hover {
  color: var(--accent);
  background: var(--accent-subtle);
}

/* View all link */
.mega-dropdown__viewall {
  display: block;
  text-align: center;
  padding: var(--sp-3) var(--sp-4);
  border-top: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--text-muted);
  text-decoration: none;
  background: var(--bg-input);
  transition: all var(--t-fast);
}
.mega-dropdown__viewall:hover {
  color: var(--accent);
  background: var(--accent-subtle);
}

/* Hide mega-menu on small screens (touch-unfriendly) */
@media (max-width: 768px) {
  .mega-dropdown { display: none !important; }
  .nav-cats { display: none; }
}

/* Controls */
.nav-controls {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  flex-shrink: 0;
  margin-left: auto;
}

.nav-search-label {
  display: none;
}
@media (min-width: 768px) {
  .nav-search-label { display: inline; }
}

/* ─── Mobile hamburger button ─────────────────────────────── */
.mobile-menu-btn {
  display: none;
}
@media (max-width: 768px) {
  .mobile-menu-btn { display: flex; }
}

.hamburger-icon line {
  transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
  transform-origin: center;
}

.mobile-menu-btn[aria-expanded="true"] .ham-top {
  transform: rotate(45deg) translate(0px, 0px);
  y1: 12; y2: 12; x1: 4; x2: 20;
}
.mobile-menu-btn[aria-expanded="true"] .ham-mid {
  opacity: 0;
}
.mobile-menu-btn[aria-expanded="true"] .ham-bot {
  transform: rotate(-45deg) translate(0px, 0px);
  y1: 12; y2: 12; x1: 4; x2: 20;
}

/* ─── Mobile drawer ───────────────────────────────────────── */
.mobile-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 150;
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  opacity: 0;
  transition: opacity 200ms ease;
}
.mobile-overlay.is-open {
  display: block;
  opacity: 1;
}

.mobile-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: min(320px, 85vw);
  height: 100dvh;
  background: var(--bg);
  border-left: 1px solid var(--border);
  z-index: 200;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: -8px 0 32px rgba(0,0,0,0.12);
}
.mobile-drawer.is-open {
  transform: translateX(0);
}

.mobile-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-4) var(--sp-5);
  border-bottom: 1px solid var(--border);
  min-height: 56px;
}

.mobile-drawer__title {
  font-family: var(--font-mono);
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
}

.mobile-drawer__close {
  color: var(--text-muted);
}
.mobile-drawer__close:hover { color: var(--text); }

.mobile-drawer__nav {
  flex: 1;
  overflow-y: auto;
  padding: var(--sp-3) 0;
}

.mobile-drawer__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
}

.mobile-drawer__link {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-5);
  text-decoration: none;
  color: var(--text);
  transition: all var(--t-fast);
  border-left: 3px solid transparent;
}
.mobile-drawer__link:hover {
  background: var(--accent-subtle);
  color: var(--cat-color, var(--accent));
  border-left-color: var(--cat-color, var(--accent));
}

.mobile-drawer__icon {
  font-size: 1.25rem;
  width: 28px;
  text-align: center;
  flex-shrink: 0;
}

.mobile-drawer__label {
  font-family: var(--font-mono);
  font-size: 0.875rem;
  font-weight: 700;
  flex: 1;
}

.mobile-drawer__count {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--text-subtle);
  background: var(--bg-input);
  border: 1px solid var(--border);
  padding: 1px 6px;
  border-radius: var(--r-full);
}

.mobile-drawer__footer {
  padding: var(--sp-4) var(--sp-5);
  border-top: 1px solid var(--border);
}

.mobile-drawer__search-link {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--text-muted);
  text-decoration: none;
  padding: var(--sp-2) 0;
}
.mobile-drawer__search-link:hover { color: var(--accent); }

/* Dark mode toggle */
.theme-toggle { position: relative; }

.theme-icon {
  position: absolute;
  transition: opacity var(--t-fast), transform var(--t-fast);
}

.theme-icon--sun  { opacity: 1;  transform: scale(1);    }
.theme-icon--moon { opacity: 0;  transform: scale(0.5);  }

.dark .theme-icon--sun  { opacity: 0; transform: scale(0.5); }
.dark .theme-icon--moon { opacity: 1; transform: scale(1);   }

/* Skip link */
.skip-link:focus {
  position: fixed;
  top: var(--sp-4);
  left: var(--sp-4);
  z-index: 9999;
  background: var(--accent-bright);
  color: #000;
  padding: var(--sp-3) var(--sp-5);
  border-radius: var(--r-md);
  font-family: var(--font-mono);
  font-weight: 700;
  clip: auto;
  width: auto;
  height: auto;
}

/* ─── Footer ────────────────────────────────────────────────── */
.site-footer {
  border-top: 1px solid var(--border);
  margin-top: var(--sp-16);
  padding: var(--sp-12) 0 var(--sp-8);
  content-visibility: auto;
  contain-intrinsic-size: auto 300px;
}

.site-footer__inner {
  display: grid;
  gap: var(--sp-8);
  grid-template-columns: 1fr;
}

/* Desktop footer grid – moved to cross-language section below */

.site-footer__tagline {
  font-size: 0.875rem;
  margin-top: var(--sp-2);
}

.footer-cat__title {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--text-muted);
  text-decoration: none;
  display: block;
}
.footer-cat__title:hover { color: var(--accent); }

.site-footer__meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-4);
  padding-top: var(--sp-6);
  border-top: 1px solid var(--border);
  font-size: 0.8rem;
}

.site-footer__meta nav {
  display: flex;
  gap: var(--sp-4);
}

.text-subtle { color: var(--text-subtle); }

/* ─── Footer cross-language links ────────────────────────── */
.site-footer__langs {
  padding-top: var(--sp-6);
  border-top: 1px solid var(--border);
}

.footer-langs__label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-subtle);
  margin-bottom: var(--sp-3);
}

.footer-langs__list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-3);
}

.footer-lang-link {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-3) var(--sp-4);
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  text-decoration: none;
  transition: all 180ms ease;
  min-width: 180px;
}

.footer-lang-link:hover {
  border-color: var(--accent);
  background: var(--accent-subtle);
  transform: translateY(-1px);
}

.footer-lang-link__flag {
  font-size: 1.25rem;
  flex-shrink: 0;
}

.footer-lang-link__name {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--text);
}

.footer-lang-link__site {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-muted);
}

.footer-lang-link__arrow {
  font-family: var(--font-mono);
  color: var(--accent);
  margin-left: auto;
  opacity: 0;
  transition: opacity 180ms ease;
}

.footer-lang-link:hover .footer-lang-link__arrow {
  opacity: 1;
}

@media (min-width: 768px) {
  .site-footer__inner {
    grid-template-columns: 280px 1fr;
    grid-template-rows: auto auto auto;
  }
  .site-footer__brand { grid-column: 1; }
  .site-footer__nav   { grid-column: 2; grid-row: 1; display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: var(--sp-4); }
  .site-footer__langs { grid-column: 1 / -1; }
  .site-footer__meta  { grid-column: 1 / -1; }
}

/* ─── Cookie consent banner ──────────────────────────────── */
.cookie-banner {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9000;
  transform: translateY(100%);
  transition: transform 350ms cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.cookie-banner.is-visible {
  transform: translateY(0);
  pointer-events: auto;
}

.cookie-banner__inner {
  max-width: var(--max-w);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-4);
  padding: var(--sp-4) var(--sp-5);
  background: var(--bg-card);
  border-top: 1px solid var(--border);
  box-shadow: 0 -4px 24px rgba(0,0,0,0.1);
}

@media (max-width: 640px) {
  .cookie-banner__inner {
    flex-direction: column;
    text-align: center;
    gap: var(--sp-3);
    padding: var(--sp-5);
  }
}

.cookie-banner__text {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.5;
}

.cookie-banner__text strong {
  color: var(--text);
}

.cookie-banner__link {
  color: var(--accent);
  text-decoration: underline;
  white-space: nowrap;
}

.cookie-banner__actions {
  display: flex;
  gap: var(--sp-2);
  flex-shrink: 0;
}

.cookie-banner__reject {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
}

.cookie-banner__accept {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
}
</style>

<script>
// ─── Dark mode toggle ────────────────────────────────────────
const themeBtn = document.getElementById("theme-toggle");
if (themeBtn) {
  themeBtn.addEventListener("click", () => {
    const html = document.documentElement;
    const isDark = html.classList.contains("dark");
    html.classList.toggle("dark", !isDark);
    html.classList.toggle("light", isDark);
    localStorage.setItem("theme", isDark ? "light" : "dark");
  });
}

// ─── Search trigger ──────────────────────────────────────────
const searchBtn = document.getElementById("search-trigger");
if (searchBtn) {
  searchBtn.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("toggle-search"));
  });
}

// ─── Mobile drawer toggle ───────────────────────────────────
const menuToggle = document.getElementById("mobile-menu-toggle");
const drawer = document.getElementById("mobile-drawer");
const overlay = document.getElementById("mobile-overlay");
const drawerClose = document.getElementById("mobile-drawer-close");

function openDrawer() {
  if (!drawer || !overlay || !menuToggle) return;
  drawer.classList.add("is-open");
  drawer.setAttribute("aria-hidden", "false");
  overlay.classList.add("is-open");
  overlay.setAttribute("aria-hidden", "false");
  menuToggle.setAttribute("aria-expanded", "true");
  menuToggle.setAttribute("aria-label", menuToggle.dataset.closeLabel || "Close menu");
  document.body.style.overflow = "hidden";
}

function closeDrawer() {
  if (!drawer || !overlay || !menuToggle) return;
  drawer.classList.remove("is-open");
  drawer.setAttribute("aria-hidden", "true");
  overlay.classList.remove("is-open");
  overlay.setAttribute("aria-hidden", "true");
  menuToggle.setAttribute("aria-expanded", "false");
  menuToggle.setAttribute("aria-label", menuToggle.dataset.openLabel || "Open menu");
  document.body.style.overflow = "";
}

if (menuToggle) {
  menuToggle.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    isOpen ? closeDrawer() : openDrawer();
  });
}
if (overlay) overlay.addEventListener("click", closeDrawer);
if (drawerClose) drawerClose.addEventListener("click", closeDrawer);

document.addEventListener("keydown", (e) => {
  if (e.key === "Escape" && drawer?.classList.contains("is-open")) closeDrawer();
});

// ─── Cookie consent banner ──────────────────────────────────
const cookieBanner = document.getElementById("cookie-banner");
const cookieAccept = document.getElementById("cookie-accept");
const cookieReject = document.getElementById("cookie-reject");

if (cookieBanner) {
  try {
    const consent = localStorage.getItem("cookie_consent");
    // Ha még nincs döntés → banner megjelenítése kis késleltetéssel
    if (!consent) {
      setTimeout(() => {
        cookieBanner.classList.add("is-visible");
        cookieBanner.setAttribute("aria-hidden", "false");
      }, 800);
    }
  } catch(e) {}

  function hideBanner() {
    if (!cookieBanner) return;
    cookieBanner.classList.remove("is-visible");
    cookieBanner.setAttribute("aria-hidden", "true");
  }

  function updateConsent(granted) {
    try {
      localStorage.setItem("cookie_consent", granted ? "granted" : "denied");
    } catch(e) {}
    // gtag consent update (ha elérhető)
    if (granted && typeof window.gtag === "function") {
      window.gtag("consent", "update", {
        ad_storage: "granted",
        ad_user_data: "granted",
        ad_personalization: "granted",
        analytics_storage: "granted",
      });
    }
    hideBanner();
  }

  if (cookieAccept) cookieAccept.addEventListener("click", () => updateConsent(true));
  if (cookieReject) cookieReject.addEventListener("click", () => updateConsent(false));
}
</script>

