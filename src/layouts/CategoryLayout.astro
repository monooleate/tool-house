---
// ============================================================
// CategoryLayout.astro
// Kategória landing oldalak layoutja (pl. /kep, /pdf)
// ============================================================
import BaseLayout from "./BaseLayout.astro";
import type { Category, Tool } from "../lib/tool-registry.ts";
import { getLocalizedCategory, getLocalizedTool } from "../lib/tool-registry.ts";
import {
  categoryBreadcrumbs,
  breadcrumbSchema,
  toolListSchema,
  buildCanonical,
} from "../lib/seo.ts";
import { t, CURRENT_LANG } from "../i18n/index.ts";
import { toolUrl, categoryUrl } from "../lib/url-utils.ts";

export interface Props {
  category: Category;
  tools: Tool[];
  title: string;
  description: string;
}

const { category: rawCategory, tools: rawTools, title, description } = Astro.props;
const category = getLocalizedCategory(rawCategory, CURRENT_LANG);
const tools = rawTools.map(tool => getLocalizedTool(tool, CURRENT_LANG));
const activeTools  = tools.filter((t) => t.status === "active");
const pendingTools = tools.filter((t) => t.status === "coming-soon");
const breadcrumbs  = categoryBreadcrumbs(category);

const schemas = [
  breadcrumbSchema(breadcrumbs),
  toolListSchema(tools, `${category.label} ${t("category.tools_suffix")}`),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={categoryUrl(rawCategory.id)}
  hreflangPaths={{ hu: categoryUrl(rawCategory.id, "hu"), ro: categoryUrl(rawCategory.id, "ro") }}
  schemaScripts={schemas}
>
  <div class="cat-page container">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list" role="list">
        {breadcrumbs.map((item, i) => (
          <li class="breadcrumb__item">
            {i < breadcrumbs.length - 1 ? (
              <>
                <a href={item.href} class="breadcrumb__link">{item.name}</a>
                <span aria-hidden="true"> / </span>
              </>
            ) : (
              <span aria-current="page">{item.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Category header -->
    <header class="cat-header" style={`--cat-color: ${category.color}`}>
      <div class="cat-header__icon" aria-hidden="true">{category.icon}</div>
      <div class="cat-header__content">
        <h1>{category.label} {t("category.tools_suffix")}</h1>
        <p>{description}</p>
        <div class="cat-header__stats">
          <span class="stat-pill">
            <span class="stat-pill__num">{activeTools.length}</span> {t("category.active_label")}
          </span>
          <span class="stat-pill stat-pill--dim">
            <span class="stat-pill__num">{pendingTools.length}</span> {t("category.coming_label")}
          </span>
        </div>
      </div>
    </header>

    <!-- Category intro (SEO) -->
    {category.intro && category.intro.length > 0 && (
      <section class="cat-intro" aria-label={`${category.label} ${t("category.description_label")}`}>
        {category.intro.map((p) => (
          <p class="cat-intro__para">{p}</p>
        ))}
      </section>
    )}

    <!-- Active tools -->
    {activeTools.length > 0 && (
      <section aria-labelledby="active-title">
        <h2 id="active-title" class="section-label">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {t("category.available_tools")}
        </h2>
        <ul class="tool-grid" role="list">
          {activeTools.map((tool) => (
            <li>
              <a href={toolUrl(tool)} class="tool-card tool-card--active">
                <div class="tool-card__title">{tool.h1}</div>
                <p class="tool-card__desc">{tool.description}</p>
                <span class="tool-card__cta">{t("category.open_tool")}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Coming soon tools -->
    {pendingTools.length > 0 && (
      <section aria-labelledby="coming-title" class="coming-section">
        <h2 id="coming-title" class="section-label section-label--muted">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          {t("category.coming_soon_tools")}
        </h2>
        <ul class="tool-grid tool-grid--compact" role="list">
          {pendingTools.map((tool) => (
            <li>
              <a href={toolUrl(tool)} class="tool-card tool-card--pending">
                <div class="tool-card__title">{tool.h1}</div>
                <p class="tool-card__desc">{tool.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </div>
</BaseLayout>

<style>
.cat-page {
  padding-top: var(--sp-6);
  padding-bottom: var(--sp-16);
}

/* Breadcrumb */
.breadcrumb__list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-2);
  list-style: none;
  padding: 0; margin: 0 0 var(--sp-5);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--text-muted);
}
.breadcrumb__link { color: var(--text-muted); text-decoration: none; }
.breadcrumb__link:hover { color: var(--accent); }

/* Category header */
.cat-header {
  display: flex;
  gap: var(--sp-6);
  align-items: flex-start;
  padding: var(--sp-8);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  margin-bottom: var(--sp-10);
  border-left: 4px solid var(--cat-color, var(--accent));
}

.cat-header__icon {
  font-size: 3rem;
  line-height: 1;
  flex-shrink: 0;
}

.cat-header__content h1 { margin-bottom: var(--sp-2); }
.cat-header__content p  { margin-bottom: var(--sp-4); }

.cat-header__stats {
  display: flex;
  gap: var(--sp-3);
  flex-wrap: wrap;
}

.stat-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--r-full);
  padding: 2px 10px;
  color: var(--text-muted);
}

.stat-pill .stat-pill__num {
  color: var(--accent);
}

.stat-pill--dim .stat-pill__num {
  color: var(--text-subtle);
}

/* Category intro (SEO description) */
.cat-intro {
  margin-bottom: var(--sp-8);
  max-width: 75ch;
}

.cat-intro__para {
  font-size: 0.9375rem;
  line-height: 1.75;
  color: var(--text-muted);
}

.cat-intro__para + .cat-intro__para {
  margin-top: var(--sp-3);
}

/* Section labels */
.section-label {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: var(--sp-5);
  padding-bottom: var(--sp-3);
  border-bottom: 1px solid var(--border);
}

.section-label--muted { color: var(--text-subtle); }

.coming-section { margin-top: var(--sp-10); }

/* Tool grid */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: var(--sp-4);
  list-style: none;
  padding: 0; margin: 0;
}

.tool-grid--compact .tool-card { padding: var(--sp-4); }

/* Tool cards */
.tool-card {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  padding: var(--sp-5);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  text-decoration: none;
  transition: all var(--t-fast);
  height: 100%;
}

.tool-card--active:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.tool-card--pending {
  opacity: 0.55;
  cursor: default;
}

.tool-card--pending:hover { opacity: 0.7; }

.tool-card__title {
  font-family: var(--font-mono);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--text);
}

.tool-card__desc {
  font-size: 0.8125rem;
  color: var(--text-muted);
  max-width: none;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tool-card__cta {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent);
  margin-top: auto;
}
</style>
