---
// ============================================================
// ProblemeTopicLayout.astro
// Pagină dedicată unei teme dintr-o clasă (RO-only)
// URL: /probleme-matematica/{clasa-N}/{tema-slug}/
// Conținut unic: notă de teorie (formule/metodă) + problemele temei,
// rezolvate pas cu pas. Schema: EducationalOrganization + Quiz
// (Practice Problems) + LearningResource + Breadcrumb.
// ============================================================
import BaseLayout from "./BaseLayout.astro";
import {
  HUB, TOPIC_THEORY, DIFFICULTY_LABEL,
  type GradeLevel, type TopicGroup,
} from "../lib/content/ro/probleme-matematica.ts";
import {
  breadcrumbNode, faqNode, educationalOrgNode, quizNode, learningResourceNode,
  buildCanonical, type BreadcrumbItem,
} from "../lib/seo.ts";
import { renderMixed } from "../lib/katex.ts";

export interface Props {
  grade: GradeLevel;
  group: TopicGroup;
  siblings: TopicGroup[];
}
const { grade, group, siblings } = Astro.props;

const hubPath = `/${HUB.slug}/`;
const gradePath = `/${HUB.slug}/${grade.slug}/`;
const selfPath = `${gradePath}${group.slug}/`;
const pageUrl = buildCanonical(selfPath);

const theory = TOPIC_THEORY[group.topic];
const n = group.exercises.length;
const nWord = n === 1 ? "problemă" : "probleme";

const title = `${group.topic} – probleme rezolvate (${grade.label})`;
const metaDescription = `Probleme rezolvate de ${group.topic.toLowerCase()} pentru ${grade.label}, cu rezolvare pas cu pas: ${n} ${nWord} cu enunț, pași și răspuns, conform programei școlare.`;

const breadcrumbs: BreadcrumbItem[] = [
  { name: "Acasă", href: "/" },
  { name: "Probleme de matematică", href: hubPath },
  { name: grade.label, href: gradePath },
  { name: group.topic, href: selfPath },
];

// Navigare prev/next între temele aceleiași clase
const idx = siblings.findIndex((s) => s.slug === group.slug);
const prev = idx > 0 ? siblings[idx - 1] : null;
const next = idx < siblings.length - 1 ? siblings[idx + 1] : null;

// ─── Schema ──────────────────────────────────────────────────
const graphNodes: Record<string, any>[] = [
  breadcrumbNode(pageUrl, breadcrumbs),
  educationalOrgNode(),
  learningResourceNode({
    pageUrl,
    name: `${group.topic} – ${grade.label}`,
    description: metaDescription,
    levels: [grade.label],
  }),
  quizNode({
    pageUrl,
    name: `${group.topic} – probleme rezolvate (${grade.label})`,
    level: grade.label,
    topicName: group.topic,
    questions: group.exercises.map((ex) => ({
      text: ex.statement,
      answer: `${ex.answer}. ${ex.steps.join(" ")}`,
    })),
  }),
];

const diffClass = (d: string) => `pm-badge--${d}`;
const suppressBrand = title.length > 46;
---

<BaseLayout
  title={title}
  description={metaDescription}
  canonical={selfPath}
  hreflangPaths={{ hu: null, ro: selfPath }}
  katex={true}
  ogType="article"
  ogImage={`/og/${HUB.slug}/${grade.slug}.png`}
  graphNodes={graphNodes}
  graphPrimaryId="#quiz"
  graphPageType="CollectionPage"
  suppressBrandSuffix={suppressBrand}
>
  <div class="pm-page container">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list" role="list">
        {breadcrumbs.map((item, i) => (
          <li class="breadcrumb__item">
            {i < breadcrumbs.length - 1 ? (
              <>
                <a href={item.href} class="breadcrumb__link">{item.name}</a>
                <span aria-hidden="true"> / </span>
              </>
            ) : (
              <span aria-current="page">{item.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- Header -->
    <header class="pm-header">
      <div class="pm-header__icon" aria-hidden="true">{grade.icon}</div>
      <div class="pm-header__content">
        <h1>{group.topic} – {grade.label}</h1>
        <p>Probleme rezolvate pas cu pas, {grade.cycle.toLowerCase()}.</p>
        <div class="pm-header__stats">
          <a class="stat-pill stat-pill--link" href={gradePath}>← {grade.label}</a>
          {grade.examBadge && <span class="stat-pill stat-pill--exam">{grade.examBadge}</span>}
          <span class="stat-pill stat-pill--alt"><span class="stat-pill__num">{n}</span> {nWord}</span>
        </div>
      </div>
    </header>

    <!-- Teorie (conținut unic) -->
    {theory && (
      <aside class="pm-theory" aria-label="Ce trebuie să reții">
        <h2 class="pm-theory__title">💡 Ce trebuie să reții</h2>
        <p class="pm-theory__body" set:html={renderMixed(theory)} />
      </aside>
    )}

    <!-- Intro -->
    <section class="pm-intro" aria-label="Introducere">
      <p class="pm-intro__para">
        Pe această pagină găsești probleme rezolvate de <strong>{group.topic.toLowerCase()}</strong> pentru <strong>{grade.label}</strong> ({grade.cycle.toLowerCase()}). Fiecare exercițiu are rezolvarea completă, pas cu pas, cu răspunsul final evidențiat.
        {grade.examBadge && ` Temă utilă pentru pregătirea la ${grade.examBadge}.`}
      </p>
    </section>

    <!-- Exercises -->
    <section class="pm-exercises" aria-labelledby="ex-title">
      <h2 id="ex-title" class="section-label">✏️ Probleme rezolvate</h2>
      <ol class="pm-ex-list" role="list">
        {group.exercises.map((ex, i) => (
          <li class="pm-ex" id={ex.id}>
            <div class="pm-ex__head">
              <span class="pm-ex__num" aria-hidden="true">{i + 1}</span>
              <span class={`pm-badge ${diffClass(ex.difficulty)}`}>{DIFFICULTY_LABEL[ex.difficulty]}</span>
            </div>
            <p class="pm-ex__statement" set:html={renderMixed(ex.statement)} />
            <details class="pm-ex__solution">
              <summary class="pm-ex__toggle">
                <span>Vezi rezolvarea</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="pm-ex__body">
                <ol class="pm-ex__steps">
                  {ex.steps.map((st) => <li set:html={renderMixed(st)} />)}
                </ol>
                <p class="pm-ex__answer">
                  <span class="pm-ex__answer-label">Răspuns:</span>
                  <span set:html={renderMixed(ex.answer)} />
                </p>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <!-- Alte teme din clasă -->
    {siblings.length > 1 && (
      <section class="pm-siblings" aria-labelledby="sib-title">
        <h2 id="sib-title" class="section-label">📚 Alte teme din {grade.label}</h2>
        <ul class="pm-topic-list" role="list">
          {siblings.filter((s) => s.slug !== group.slug).map((s) => (
            <li>
              <a class="pm-topic" href={`${gradePath}${s.slug}/`}>
                {s.topic} <span class="pm-topic__badge">{s.exercises.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Prev/Next + back -->
    <nav class="pm-nav" aria-label="Navigare între teme">
      {prev
        ? <a href={`${gradePath}${prev.slug}/`} class="pm-nav__link pm-nav__link--prev">← {prev.topic}</a>
        : <span></span>}
      <a href={gradePath} class="pm-nav__hub">Toate temele clasei</a>
      {next
        ? <a href={`${gradePath}${next.slug}/`} class="pm-nav__link pm-nav__link--next">{next.topic} →</a>
        : <span></span>}
    </nav>

  </div>
</BaseLayout>

<style>
.pm-page { padding-top: var(--sp-6); padding-bottom: var(--sp-16); }

.breadcrumb__list {
  display: flex; flex-wrap: wrap; gap: var(--sp-2);
  list-style: none; padding: 0; margin: 0 0 var(--sp-5);
  font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted);
}
.breadcrumb__link { color: var(--text-muted); text-decoration: none; }
.breadcrumb__link:hover { color: var(--accent); }

.pm-header {
  display: flex; gap: var(--sp-6); align-items: flex-start;
  padding: var(--sp-8); background: var(--bg-card);
  border: 1px solid var(--border); border-radius: var(--r-xl);
  margin-bottom: var(--sp-6); border-left: 4px solid var(--accent);
}
.pm-header__icon { font-size: 3rem; line-height: 1; flex-shrink: 0; }
.pm-header__content h1 { margin-bottom: var(--sp-2); }
.pm-header__content p { margin-bottom: var(--sp-4); max-width: 60ch; color: var(--text-muted); }
.pm-header__stats { display: flex; gap: var(--sp-3); flex-wrap: wrap; align-items: center; }
.stat-pill {
  display: inline-flex; align-items: center; gap: var(--sp-1);
  font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700;
  background: var(--bg-input); border: 1px solid var(--border);
  border-radius: var(--r-full); padding: 2px 10px; color: var(--text-muted);
}
.stat-pill__num { color: var(--accent); }
.stat-pill--exam { background: var(--accent); color: #fff; border-color: transparent; }
.stat-pill--link { text-decoration: none; }
.stat-pill--link:hover { border-color: var(--accent); color: var(--accent); }

/* Teorie box */
.pm-theory {
  padding: var(--sp-5) var(--sp-6);
  background: color-mix(in srgb, var(--accent) 8%, var(--bg-card));
  border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
  border-radius: var(--r-md);
  margin-bottom: var(--sp-6);
}
.pm-theory__title { font-size: 1rem; margin: 0 0 var(--sp-2); }
.pm-theory__body { margin: 0; font-size: 0.95rem; line-height: 1.7; color: var(--text); }

.pm-intro { margin-bottom: var(--sp-8); max-width: 75ch; }
.pm-intro__para { font-size: 0.9375rem; line-height: 1.75; color: var(--text-muted); margin: 0; }
.pm-intro__para strong { color: var(--text); }

.section-label {
  display: flex; align-items: center; gap: var(--sp-2);
  font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted);
  margin-bottom: var(--sp-4); padding-bottom: var(--sp-3); border-bottom: 1px solid var(--border);
}

/* Exercises */
.pm-exercises { margin-bottom: var(--sp-10); }
.pm-ex-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--sp-4); }
.pm-ex {
  padding: var(--sp-5); background: var(--bg-card);
  border: 1px solid var(--border); border-radius: var(--r-md);
}
.pm-ex__head { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-3); flex-wrap: wrap; }
.pm-ex__num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 1.6rem; height: 1.6rem; flex-shrink: 0;
  background: var(--accent); color: #fff; border-radius: var(--r-full);
  font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700;
}
.pm-badge { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; padding: 2px 10px; border-radius: var(--r-full); border: 1px solid transparent; }
.pm-badge--usor    { background: #16a34a1a; color: #16a34a; border-color: #16a34a55; }
.pm-badge--mediu   { background: #d977061a; color: #d97706; border-color: #d9770655; }
.pm-badge--dificil { background: #dc26261a; color: #dc2626; border-color: #dc262655; }
.pm-ex__statement { font-size: 1rem; line-height: 1.7; color: var(--text); margin: 0; }
.pm-ex__solution { margin-top: var(--sp-3); border-top: 1px dashed var(--border); }
.pm-ex__toggle {
  display: flex; align-items: center; gap: var(--sp-2); cursor: pointer;
  padding: var(--sp-3) 0 0; list-style: none;
  font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: var(--accent);
}
.pm-ex__toggle::-webkit-details-marker { display: none; }
.pm-ex__toggle svg { transition: transform 0.2s; }
.pm-ex__solution[open] .pm-ex__toggle svg { transform: rotate(180deg); }
.pm-ex__body { padding-top: var(--sp-3); }
.pm-ex__steps { margin: 0 0 var(--sp-3); padding-left: 1.4rem; display: flex; flex-direction: column; gap: var(--sp-2); }
.pm-ex__steps li { font-size: 0.92rem; line-height: 1.7; color: var(--text-muted); }
.pm-ex__answer {
  margin: 0; padding: var(--sp-3) var(--sp-4);
  background: #16a34a12; border: 1px solid #16a34a44; border-radius: var(--r-sm);
  font-size: 0.95rem; color: var(--text);
}
.pm-ex__answer-label { font-family: var(--font-mono); font-weight: 700; color: #16a34a; margin-right: var(--sp-2); }

/* Siblings */
.pm-siblings { margin-bottom: var(--sp-8); }
.pm-topic-list { display: flex; flex-wrap: wrap; gap: var(--sp-2); list-style: none; padding: 0; margin: 0; }
.pm-topic {
  display: inline-flex; align-items: center; gap: var(--sp-2);
  font-size: 0.85rem; padding: var(--sp-2) var(--sp-3) var(--sp-2) var(--sp-4);
  background: var(--bg-input); border: 1px solid var(--border);
  border-radius: var(--r-full); color: var(--text); text-decoration: none; transition: all var(--t-fast);
}
.pm-topic:hover { border-color: var(--accent); color: var(--accent); }
.pm-topic__badge {
  font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700;
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--r-full); padding: 0 8px; color: var(--text-muted);
}

/* Prev/next nav */
.pm-nav {
  margin-top: var(--sp-6); display: flex; align-items: center; justify-content: space-between;
  gap: var(--sp-3); flex-wrap: wrap;
}
.pm-nav__link, .pm-nav__hub {
  font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700;
  text-decoration: none; color: var(--text); padding: var(--sp-2) var(--sp-4);
  border: 1px solid var(--border); border-radius: var(--r-md); transition: all var(--t-fast);
  max-width: 46%;
}
.pm-nav__link:hover, .pm-nav__hub:hover { border-color: var(--accent); color: var(--accent); }
.pm-nav__hub { color: var(--text-muted); }

@media (max-width: 640px) {
  .pm-header { flex-direction: column; gap: var(--sp-4); padding: var(--sp-5); }
}
</style>

<script>
  // details reveal e nativ; nu e nevoie de JS suplimentar.
</script>
