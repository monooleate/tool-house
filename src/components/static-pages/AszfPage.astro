---
// ============================================================
// AszfPage.astro – Felhasználási feltételek (ÁSZF) / Terms of Service
// ============================================================
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME, SITE_URL, breadcrumbNode, buildCanonical } from "../../lib/seo.ts";
import { t, tpl, CURRENT_LANG, CURRENT_CONFIG } from "../../i18n/index.ts";
import { staticUrl } from "../../lib/url-utils.ts";

const sn = CURRENT_CONFIG.siteName;
const contactEmail = t("contact.email_address");

const pageUrl = buildCanonical(staticUrl("aszf"));
const graphNodes: Record<string, any>[] = [
  breadcrumbNode(pageUrl, [
    { name: t("tos.breadcrumb_home"), href: "/" },
    { name: t("tos.breadcrumb"), href: staticUrl("aszf") },
  ]),
];

const lastUpdated = "2026-03-22";
---

<BaseLayout
  title={tpl("tos.meta_title", { siteName: sn })}
  description={tpl("tos.meta_desc", { siteName: sn })}
  canonical={staticUrl("aszf")}
  hreflangPaths={{ hu: staticUrl("aszf", "hu"), ro: staticUrl("aszf", "ro") }}
  graphNodes={graphNodes}
>

  <div class="legal-page container">
    <header class="legal-header">
      <nav class="legal-breadcrumb" aria-label="Breadcrumb">
        <a href="/">{t("tos.breadcrumb_home")}</a>
        <span aria-hidden="true">›</span>
        <span>{t("tos.breadcrumb")}</span>
      </nav>
      <h1 class="legal-title">{t("tos.heading")}</h1>
      <p class="legal-updated">{t("tos.last_updated")} {lastUpdated}</p>
    </header>

    <div class="legal-body">

      <section class="legal-section">
        <div class="legal-highlight">
          <span class="legal-highlight__icon" aria-hidden="true">📋</span>
          <div>{tpl("tos.intro", { siteName: sn })}</div>
        </div>
      </section>

      <section class="legal-section">
        <h2 class="legal-section__title" id="szolgaltatas">{t("tos.s1_title")}</h2>
        <p>{tpl("tos.s1_p1", { siteName: sn })}</p>
      </section>

      <section class="legal-section">
        <h2 class="legal-section__title" id="hasznalat">{t("tos.s2_title")}</h2>
        <p>{t("tos.s2_p1")}</p>
        <p>{t("tos.s2_p2")}</p>
      </section>

      <section class="legal-section">
        <h2 class="legal-section__title" id="felelosseg">{t("tos.s3_title")}</h2>
        <p>{t("tos.s3_p1")}</p>
        <p>{t("tos.s3_p2")}</p>
      </section>

      <section class="legal-section">
        <h2 class="legal-section__title" id="szellemi-tulajdon">{t("tos.s4_title")}</h2>
        <p>{tpl("tos.s4_p1", { siteName: sn })}</p>
      </section>

      <section class="legal-section">
        <h2 class="legal-section__title" id="adatvedelem">{t("tos.s5_title")}</h2>
        <p>{t("tos.s5_p1")}</p>
        <p><a href={staticUrl("adatvedelmi")}>{t("tos.privacy_link")}</a></p>
      </section>

      <section class="legal-section">
        <h2 class="legal-section__title" id="modositasok">{t("tos.s6_title")}</h2>
        <p>{t("tos.s6_p1")}</p>
      </section>

      <section class="legal-section">
        <h2 class="legal-section__title" id="kapcsolat">{t("tos.s7_title")}</h2>
        <p><Fragment set:html={tpl("tos.s7_p1", { email: contactEmail })} /></p>
      </section>

    </div>
  </div>

</BaseLayout>

<style>
/* ─── Legal page layout ──────────────────────────────────── */
.legal-page {
  padding-top: var(--sp-12);
  padding-bottom: var(--sp-16);
  max-width: 800px;
}

.legal-breadcrumb {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-subtle);
  margin-bottom: var(--sp-6);
}
.legal-breadcrumb a {
  color: var(--text-muted);
  text-decoration: none;
}
.legal-breadcrumb a:hover { color: var(--accent); }

.legal-title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  letter-spacing: -0.02em;
  margin-bottom: var(--sp-2);
}

.legal-updated {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-subtle);
}

.legal-body {
  margin-top: var(--sp-10);
  display: flex;
  flex-direction: column;
  gap: var(--sp-10);
}

/* Highlight box */
.legal-highlight {
  display: flex;
  gap: var(--sp-4);
  padding: var(--sp-5) var(--sp-6);
  background: var(--accent-subtle);
  border: 1px solid var(--accent)30;
  border-left: 4px solid var(--accent);
  border-radius: var(--r-md);
  font-size: 0.9375rem;
  line-height: 1.7;
  color: var(--text-muted);
}
.legal-highlight strong { color: var(--text); }
.legal-highlight__icon {
  font-size: 1.5rem;
  flex-shrink: 0;
  margin-top: 2px;
}

/* Sections */
.legal-section__title {
  font-size: 1.25rem;
  margin-bottom: var(--sp-4);
  padding-bottom: var(--sp-3);
  border-bottom: 1px solid var(--border);
}

.legal-section p {
  font-size: 0.9375rem;
  line-height: 1.75;
  color: var(--text-muted);
}
.legal-section p + p { margin-top: var(--sp-3); }
.legal-section strong { color: var(--text); }
.legal-section a { color: var(--accent); text-decoration: underline; }
.legal-section a:hover { color: var(--accent-dim); }
</style>
