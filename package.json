{
  "name": "eszkoztár",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:ro": "cross-env PUBLIC_SITE_LANG=ro PUBLIC_SITE_URL=https://instrumenteonline.ro astro dev",
    "build": "astro build",
    "build:hu": "cross-env PUBLIC_SITE_LANG=hu PUBLIC_SITE_URL=https://konvertalo.hu astro build",
    "build:ro": "cross-env PUBLIC_SITE_LANG=ro PUBLIC_SITE_URL=https://instrumenteonline.ro astro build",
    "build:all": "npm run build:hu && npm run build:ro",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "tsc --noEmit",
    "gen-pages": "node scripts/gen-pages.mjs",
    "gen-pages:force": "node scripts/gen-pages.mjs --force",
    "gen-pages:dry": "node scripts/gen-pages.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/svelte": "^7.2.5",
    "astro": "^5.17.3",
    "fflate": "^0.8.2",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "svelte": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/js-yaml": "^4.0.9",
    "cross-env": "^10.1.0",
    "satori": "^0.11.2",
    "typescript": "^5.5.0"
  }
}
